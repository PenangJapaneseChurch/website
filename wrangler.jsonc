{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "penang",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pjc-db",
			"migrations_dir": "../../migrations",
			"database_id": "fa491e4e-e396-4cb6-8774-8ee65fba93ef"
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "pjc-images"
		},
	],
	// Worker Loader for plugin sandboxing (disabled for free tier)
	// "worker_loaders": [
	// 	{
	// 		"binding": "LOADER",
	// 	},
	// ],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}
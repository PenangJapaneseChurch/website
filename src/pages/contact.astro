---
import Base from "../layouts/Base.astro";
---

<Base title="お問い合わせ — ペナン日本人教会" description="ペナン日本人教会へのお問い合わせはこちらから。">
	<section class="page-section">
		<div class="section-inner">
			<h1 class="page-title">お問い合わせ</h1>

			<div class="content-block">
				<p class="lead desktop-only">
					礼拝や教会についてのご質問は、以下のフォームから<br/>
					お気軽にお問い合わせください。
				</p>
				<p class="lead mobile-only">
					礼拝や教会についてのご質問は<br/>
					以下のフォームからお気軽に<br/>
					お問い合わせください。
				</p>
			</div>

			<div class="content-block">
				<div class="form-wrapper">
					<iframe
						src="https://docs.google.com/forms/d/e/1FAIpQLSefA8wHLXWnZ774mYpx2FhEt5Q3LHyOxzlyN555LjKQanUGbQ/viewform?embedded=true"
						width="100%"
						height="850"
						frameborder="0"
						marginheight="0"
						marginwidth="0"
					>
						読み込んでいます…
					</iframe>
				</div>
			</div>

			<div class="content-block">
				<h2>アクセス</h2>
				<p>ペナン島タンジュン・ブンガ（詳細はお問い合わせください）</p>
				<div class="map-wrapper">
					<iframe
						src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d44934.6323429398!2d100.2789542751802!3d5.462728919650557!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x304ae81ecd8b86b5%3A0xb25d21e469e4c2e9!2zVGFuanVuZyBCdW5nYWgsIOODmuODiuODsw!5e0!3m2!1sja!2smy!4v1785069607098!5m2!1sja!2smy"
						width="100%"
						height="400"
						style="border:0;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="strict-origin-when-cross-origin"
					>
					</iframe>
				</div>
			</div>

			<div class="content-block">
				<h2>SNS</h2>
				<div class="sns-links">
					<a href="https://www.facebook.com/groups/412402279749999/" target="_blank" rel="noopener noreferrer" class="sns-link">
						Facebook
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.section-inner {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}
	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		text-align: center;
		margin-bottom: var(--spacing-12);
	}
	.content-block {
		margin-bottom: var(--spacing-12);
	}
	.content-block h2 {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-4);
		padding-bottom: var(--spacing-3);
		border-bottom: 1px solid var(--color-border-subtle);
	}
	.lead {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
		text-align: center;
	}
	.form-wrapper {
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}
	.map-wrapper {
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		overflow: hidden;
		margin-top: var(--spacing-4);
	}
	.sns-links {
		display: flex;
		gap: var(--spacing-4);
	}
	.sns-link {
		display: inline-block;
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--color-text);
		font-size: var(--font-size-sm);
		transition: background var(--transition-fast);
	}
	.sns-link:hover { background: var(--color-border-subtle); }

	.desktop-only { display: block; }
	.mobile-only { display: none; }
	@media (max-width: 768px) {
		.desktop-only { display: none; }
		.mobile-only { display: block; }
	}
</style>

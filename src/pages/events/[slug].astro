---
import { getEmDashEntry, getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
	const { entries } = await getEmDashCollection("events");
	return entries.map((entry) => ({
		params: { slug: entry.data.slug || entry.id },
	}));
}

const { slug } = Astro.params;
const { entry } = await getEmDashEntry("events", slug);
if (!entry) return Astro.redirect("/events");
---

<Base title={`${entry.data.title} — ペナン日本人教会`} description={entry.data.description}>
	<article class="page-section">
		<div class="section-inner">
			<header class="article-header">
				<h1 class="article-title">{entry.data.title}</h1>
				<div class="article-meta">
					{entry.data.date && (
						<time>
							{new Date(entry.data.date).toLocaleDateString("ja-JP", {
								year: "numeric", month: "long", day: "numeric"
							})}
							{entry.data.end_date && (
								<> 〜 {new Date(entry.data.end_date).toLocaleDateString("ja-JP", {
									year: "numeric", month: "long", day: "numeric"
								})}</>
							)}
						</time>
					)}
					{entry.data.location && (
						<span class="article-location">{entry.data.location}</span>
					)}
				</div>
			</header>

			{entry.data.description && (
				<div class="article-body">
					<p>{entry.data.description}</p>
				</div>
			)}

			<footer class="article-footer">
				<a href="/events" class="back-link">← イベント一覧に戻る</a>
			</footer>
		</div>
	</article>
</Base>

<style>
	.section-inner {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}
	.article-header {
		margin-bottom: var(--spacing-10);
	}
	.article-title {
		font-size: var(--font-size-3xl);
		font-weight: var(--font-weight-display);
	}
	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		margin-top: var(--spacing-4);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.article-location {
		color: var(--color-brand);
		font-weight: 500;
	}
	.article-body p {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		margin-bottom: var(--spacing-6);
	}
	.article-footer {
		margin-top: var(--spacing-12);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border-subtle);
	}
	.back-link {
		color: var(--color-brand);
		text-decoration: none;
		font-size: var(--font-size-sm);
	}
	.back-link:hover { color: var(--color-brand-hover); }
</style>

---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Fetch latest items from each collection
const [{ entries: sermons }, { entries: news }, { entries: events }, settings] = await Promise.all([
	getEmDashCollection("sermons", { orderBy: { date: "desc" }, limit: 1 }),
	getEmDashCollection("news", { orderBy: { date: "desc" }, limit: 3 }),
	getEmDashCollection("events", { orderBy: { date: "asc" }, limit: 3 }),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

const latestSermon = sermons[0] ?? null;
---

<Base title={siteTitle} description={siteTagline}>
	<!-- Hero Section -->
	<section class="hero">
		<div class="hero-content">
			<h1 class="hero-title">ペナン日本人教会</h1>
			<p class="hero-subtitle">Penang Japanese Church</p>
			<p class="hero-verse">「神は実に、そのひとり子をお与えになったほどに世を愛された。」<br/>ヨハネ 3:16</p>
			<div class="hero-actions">
				<a href="/about" class="hero-btn hero-btn-primary">教会について</a>
				<a href="/contact" class="hero-btn hero-btn-secondary">アクセス</a>
			</div>
		</div>
	</section>

	<!-- Welcome Section -->
	<section class="welcome">
		<div class="section-inner">
			<h2 class="section-heading">ようこそ</h2>
			<p class="welcome-text">
				ペナン日本人教会は、マレーシア・ペナン島にあるプロテスタント教会です。
				毎週日曜日の礼拝を日本語で行っています。
				ペナンにお住まいの日本人の方、旅行中の方、どなたでもお気軽にお越しください。
			</p>
		</div>
	</section>

	<!-- Sunday Service -->
	<section class="service">
		<div class="section-inner">
			<h2 class="section-heading">日曜礼拝</h2>
			<div class="service-card">
				<div class="service-item">
					<h3>礼拝時間</h3>
					<p>毎週日曜日<br/>午前10:30 〜 12:00</p>
				</div>
				<div class="service-item">
					<h3>場所</h3>
					<p>ペナン島タンジュン・ブンガ<br/>（詳細はお問い合わせください）</p>
				</div>
				<div class="service-item">
					<h3>言語</h3>
					<p>日本語</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Latest Sermon -->
	{latestSermon && (
		<section class="latest-sermon">
			<div class="section-inner">
				<h2 class="section-heading">今週の説教</h2>
				<div class="sermon-card">
					<h3 class="sermon-title">
						<a href={`/sermons/${latestSermon.data.slug || latestSermon.id}`}>
							{latestSermon.data.title}
						</a>
					</h3>
					{latestSermon.data.date && (
						<time class="sermon-date">
							{new Date(latestSermon.data.date).toLocaleDateString("ja-JP", {
								year: "numeric", month: "long", day: "numeric"
							})}
						</time>
					)}
					{latestSermon.data.passage && (
						<p class="sermon-passage">聖書箇所: {latestSermon.data.passage}</p>
					)}
					{latestSermon.data.speaker && (
						<p class="sermon-speaker">説教者: {latestSermon.data.speaker}</p>
					)}
					<a href="/sermons" class="section-link">説教一覧を見る →</a>
				</div>
			</div>
		</section>
	)}

	<!-- Latest News -->
	{news.length > 0 && (
		<section class="latest-news">
			<div class="section-inner">
				<h2 class="section-heading">お知らせ</h2>
				<div class="news-grid">
					{news.map((item) => (
						<article class="news-card">
							<time class="news-date">
								{new Date(item.data.date).toLocaleDateString("ja-JP", {
									year: "numeric", month: "long", day: "numeric"
								})}
							</time>
							<h3 class="news-title">
								<a href={`/news/${item.data.slug || item.id}`}>
									{item.data.title}
								</a>
							</h3>
						</article>
					))}
				</div>
				<a href="/news" class="section-link">すべてのお知らせ →</a>
			</div>
		</section>
	)}

	<!-- Upcoming Events -->
	{events.length > 0 && (
		<section class="upcoming-events">
			<div class="section-inner">
				<h2 class="section-heading">今後のイベント</h2>
				<div class="events-grid">
					{events.map((item) => (
						<article class="event-card">
							<time class="event-date">
								{new Date(item.data.date).toLocaleDateString("ja-JP", {
									year: "numeric", month: "long", day: "numeric"
								})}
							</time>
							<h3 class="event-title">
								<a href={`/events/${item.data.slug || item.id}`}>
									{item.data.title}
								</a>
							</h3>
							{item.data.location && (
								<p class="event-location">{item.data.location}</p>
							)}
						</article>
					))}
				</div>
				<a href="/events" class="section-link">すべてのイベント →</a>
			</div>
		</section>
	)}

	<!-- Contact CTA -->
	<section class="contact-cta">
		<div class="section-inner">
			<h2 class="section-heading">お問い合わせ</h2>
			<p>礼拝や教会についてのご質問は、お気軽にお問い合わせください。</p>
			<a href="/contact" class="hero-btn hero-btn-primary">お問い合わせ</a>
		</div>
	</section>
</Base>

<style>
	.section-inner {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	.section-heading {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		text-align: center;
		margin-bottom: var(--spacing-8);
	}

	.section-link {
		display: inline-block;
		margin-top: var(--spacing-6);
		color: var(--color-brand);
		text-decoration: none;
		font-size: var(--font-size-sm);
	}
	.section-link:hover { color: var(--color-brand-hover); }

	/* Hero */
	.hero {
		background: var(--color-surface);
		text-align: center;
		padding: var(--spacing-20) var(--spacing-6);
	}
	.hero-title {
		font-size: var(--font-size-5xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-3);
	}
	.hero-subtitle {
		font-size: var(--font-size-xl);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-8);
	}
	.hero-verse {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		font-style: italic;
		margin-bottom: var(--spacing-10);
		max-width: 500px;
		margin-left: auto;
		margin-right: auto;
		white-space: nowrap;
	}
	.hero-actions {
		display: flex;
		justify-content: center;
		gap: var(--spacing-4);
	}
	.hero-btn {
		display: inline-block;
		padding: var(--spacing-3) var(--spacing-8);
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 500;
		transition: background var(--transition-fast);
	}
	.hero-btn-primary {
		background: var(--color-brand);
		color: var(--color-on-brand);
	}
	.hero-btn-primary:hover { background: var(--color-brand-hover); }
	.hero-btn-secondary {
		background: var(--color-border);
		color: var(--color-text);
	}
	.hero-btn-secondary:hover { background: var(--color-border-subtle); }

	/* Welcome */
	.welcome { background: var(--color-bg); }
	.welcome-text {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		text-align: center;
		max-width: 600px;
		margin: 0 auto;
	}

	/* Sunday Service */
	.service { background: var(--color-surface); }
	.service-card {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-6);
		text-align: center;
	}
	.service-item p {
		white-space: nowrap;
	}
	.service-item h3 {
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
	}

	/* Latest Sermon */
	.latest-sermon { background: var(--color-bg); }
	.sermon-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		padding: var(--spacing-8);
	}
	.sermon-title { font-size: var(--font-size-xl); margin-bottom: var(--spacing-3); }
	.sermon-title a { color: var(--color-text); text-decoration: none; }
	.sermon-title a:hover { color: var(--color-brand); }
	.sermon-date { font-size: var(--font-size-sm); color: var(--color-muted); }
	.sermon-passage, .sermon-speaker { font-size: var(--font-size-sm); color: var(--color-text-secondary); margin-top: var(--spacing-2); }

	/* Latest News */
	.latest-news { background: var(--color-surface); }
	.news-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-6);
	}
	.news-card {
		background: var(--color-bg);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		padding: var(--spacing-6);
	}
	.news-date { font-size: var(--font-size-xs); color: var(--color-muted); }
	.news-title { font-size: var(--font-size-base); margin-top: var(--spacing-2); }
	.news-title a { color: var(--color-text); text-decoration: none; }
	.news-title a:hover { color: var(--color-brand); }

	/* Upcoming Events */
	.upcoming-events { background: var(--color-bg); }
	.events-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-6);
	}
	.event-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		padding: var(--spacing-6);
	}
	.event-date { font-size: var(--font-size-xs); color: var(--color-muted); }
	.event-title { font-size: var(--font-size-base); margin-top: var(--spacing-2); }
	.event-title a { color: var(--color-text); text-decoration: none; }
	.event-title a:hover { color: var(--color-brand); }
	.event-location { font-size: var(--font-size-sm); color: var(--color-muted); margin-top: var(--spacing-1); }

	/* Contact CTA */
	.contact-cta {
		background: var(--color-surface);
		text-align: center;
	}
	.contact-cta p {
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-6);
		font-size: var(--font-size-lg);
	}

	/* Responsive */
	@media (max-width: 768px) {
		.service-card, .news-grid, .events-grid { grid-template-columns: 1fr; }
		.hero-title { font-size: var(--font-size-3xl); }
		.hero-verse { white-space: normal; }
		.service-item p { white-space: normal; }
	}
</style>


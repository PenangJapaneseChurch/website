---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const { entries: allSermons } = await getEmDashCollection("sermons", {
	orderBy: { date: "desc" },
});
---

<Base title="礼拝 — ペナン日本人教会" description="ペナン日本人教会の週替わり礼拝一覧。">
	<section class="page-section">
		<div class="section-inner">
			<h1 class="page-title">礼拝</h1>

			{allSermons.length === 0 ? (
				<p class="empty">礼拝はまだありません。</p>
			) : (
				<div class="sermons-list">
					{allSermons.map((item) => (
						<article class="sermon-card">
							<time class="sermon-date">
								{new Date(item.data.date).toLocaleDateString("ja-JP", {
									year: "numeric", month: "long", day: "numeric"
								})}
							</time>
							<h2 class="sermon-title">
								<a href={`/sermons/${item.data.slug || item.id}`}>
									{item.data.title}
								</a>
							</h2>
							<div class="sermon-meta">
								{item.data.passage && (
									<span class="sermon-passage">{item.data.passage}</span>
								)}
								{item.data.speaker && (
									<span class="sermon-speaker">{item.data.speaker}</span>
								)}
								{item.data.series && (
									<span class="sermon-series">{item.data.series}</span>
								)}
							</div>
							{item.data.description && (
								<p class="sermon-desc">{item.data.description}</p>
							)}
						</article>
					))}
				</div>
			)}
		</div>
	</section>
</Base>

<style>
	.section-inner {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}
	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		text-align: center;
		margin-bottom: var(--spacing-12);
	}
	.sermons-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-8);
	}
	.sermon-card {
		padding-bottom: var(--spacing-6);
		border-bottom: 1px solid var(--color-border-subtle);
	}
	.sermon-date {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}
	.sermon-title {
		font-size: var(--font-size-xl);
		margin-top: var(--spacing-2);
	}
	.sermon-title a {
		color: var(--color-text);
		text-decoration: none;
	}
	.sermon-title a:hover { color: var(--color-brand); }
	.sermon-meta {
		display: flex;
		gap: var(--spacing-3);
		margin-top: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}
	.sermon-desc {
		margin-top: var(--spacing-3);
		font-size: var(--font-size-base);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}
	.empty {
		text-align: center;
		color: var(--color-muted);
	}
</style>

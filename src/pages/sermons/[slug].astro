---
import { getEmDashEntry, getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
	const { entries } = await getEmDashCollection("sermons");
	return entries.map((entry) => ({
		params: { slug: entry.data.slug || entry.id },
	}));
}

const { slug } = Astro.params;
const { entry } = await getEmDashEntry("sermons", slug);
if (!entry) return Astro.redirect("/sermons");
---

<Base title={`${entry.data.title} — ペナン日本人教会`} description={entry.data.description}>
	<article class="page-section">
		<div class="section-inner">
			<header class="article-header">
				<h1 class="article-title">{entry.data.title}</h1>
				<div class="article-meta">
					{entry.data.date && (
						<time>
							{new Date(entry.data.date).toLocaleDateString("ja-JP", {
								year: "numeric", month: "long", day: "numeric"
							})}
						</time>
					)}
					{entry.data.speaker && (
						<span class="article-speaker">説教者: {entry.data.speaker}</span>
					)}
					{entry.data.passage && (
						<span class="article-passage">聖書箇所: {entry.data.passage}</span>
					)}
					{entry.data.series && (
						<span class="article-series">シリーズ: {entry.data.series}</span>
					)}
				</div>
			</header>

			{entry.data.video_url && (
				<div class="video-embed">
					<iframe
						src={entry.data.video_url}
						width="100%"
						height="400"
						style="border:none;overflow:hidden"
						allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
						allowFullScreen
					/>
				</div>
			)}

			{entry.data.description && (
				<div class="article-body">
					<p>{entry.data.description}</p>
				</div>
			)}

			<footer class="article-footer">
				<a href="/sermons" class="back-link">← 礼拝一覧に戻る</a>
			</footer>
		</div>
	</article>
</Base>

<style>
	.section-inner {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}
	.article-header {
		margin-bottom: var(--spacing-10);
	}
	.article-title {
		font-size: var(--font-size-3xl);
		font-weight: var(--font-weight-display);
	}
	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		margin-top: var(--spacing-4);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.article-speaker { color: var(--color-brand); font-weight: 500; }
	.article-passage, .article-series { color: var(--color-text-secondary); }
	.video-embed {
		margin-bottom: var(--spacing-10);
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-surface);
	}
	.article-body p {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		margin-bottom: var(--spacing-6);
	}
	.article-footer {
		margin-top: var(--spacing-12);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border-subtle);
	}
	.back-link {
		color: var(--color-brand);
		text-decoration: none;
		font-size: var(--font-size-sm);
	}
	.back-link:hover { color: var(--color-brand-hover); }
</style>
